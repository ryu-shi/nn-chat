generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Post {
  id        Int      @id @default(autoincrement())
  message   String
  postedBy  String   @db.VarChar(255)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
}
